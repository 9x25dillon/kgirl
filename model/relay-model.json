{
  "modelVersion": 1,
  "about": "Executable model of Context Relay: pack primitives, route compositions, controls, and the blast-radius propagation graph. Checked by tools/relay-model.mjs. Pre-Checkpoint-A design artifact; SPEC.md supersedes it for the pack format once frozen.",

  "scales": {
    "S": "Severity. 1 cosmetic; 2 feature degraded; 3 feature lost or one session's context lost; 4 data loss across sessions, or visible disruption of the host tool; 5 security compromise: code execution, secret egress, persistent injection.",
    "L": "Likelihood. 1 rare, needs a targeted attack or an unusual environment; 2 unlikely; 3 plausible within the first year; 4 likely; 5 near-certain.",
    "D": "Detectability, inverted. 1 caught immediately by CI or the user; 3 caught eventually; 5 silent."
  },

  "trust": {
    "origins": ["session", "foreign", "model"],
    "note": "Effective trust is 'user' when the pack carries an approval stamp bound to its current hash, else its origin.",
    "autoInject": ["user", "session"],
    "instruction": ["user"],
    "serve": { "mcp": ["user", "session"], "nmh": ["user", "session"] }
  },

  "formats": {
    "brief": { "maxChars": 8000, "note": "Proposed budget. Leaves 2,000 chars for the wrapper and headroom under the 10,000-char hook cap." },
    "full": { "maxChars": null },
    "md": { "maxChars": null },
    "agents-md": { "maxChars": null },
    "json": { "maxChars": null }
  },
  "wrapOverheadChars": 600,

  "sinks": {
    "cc.session-start": { "class": "context", "capacityChars": 10000, "fact": "PN-01" },
    "cc.bash-output": { "class": "context", "capacityChars": 30000, "fact": "PN-09" },
    "mcp.result": { "class": "context", "capacityChars": 30000, "fact": "PN-07" },
    "cai.composer": { "class": "context", "capacityChars": 1048576, "fact": "PN-08" },
    "cai.upload": { "class": "context", "capacityChars": null },
    "file.agents-md": { "class": "instruction", "capacityChars": null },
    "file.ctxpack": { "class": "data", "capacityChars": null },
    "stdout": { "class": "data", "capacityChars": null },
    "git.commit": { "class": "data", "capacityChars": null, "requiresSealed": true }
  },

  "actors": ["human", "hook", "model"],

  "primitives": {
    "capture":  { "in": "Source",   "out": "Pack",    "origin": "session", "surfaces": ["hooks", "cli"], "actors": ["hook", "human", "model"], "effects": ["fs.read"] },
    "import":   { "in": "External", "out": "Pack",    "origin": "foreign", "surfaces": ["cli", "hooks", "mcp"], "actors": ["human", "hook", "model"], "effects": ["fs.read"] },
    "via":      { "in": "External", "out": "External", "surfaces": ["cli"], "actors": ["human"], "effects": ["exec"] },
    "propose":  { "in": "Text",     "out": "Pack",    "origin": "model", "surfaces": ["mcp"], "actors": ["model"], "effects": [] },
    "validate": { "in": "Pack", "out": "Pack", "adds": ["validated"], "surfaces": "*", "actors": "*", "effects": [] },
    "redact":   { "in": "Pack", "out": "Pack", "adds": ["redacted"], "surfaces": "*", "actors": "*", "effects": [] },
    "seal":     { "in": "Pack", "out": "Pack", "requires": ["validated", "redacted"], "adds": ["sealed"], "surfaces": "*", "actors": "*", "effects": [] },
    "edit":     { "in": "Pack", "out": "Pack", "removes": ["sealed", "approved"], "surfaces": ["cli", "mcp"], "actors": ["human", "model"], "effects": [] },
    "approve":  { "in": "Pack", "out": "Pack", "requires": ["validated", "redacted", "sealed"], "adds": ["approved"], "surfaces": ["cli"], "actors": ["human"], "effects": ["fs.write"] },
    "audit":    { "in": "Pack", "out": "Pack", "requires": ["validated"], "adds": ["audited"], "surfaces": ["cli", "hooks"], "actors": "*", "effects": ["fs.read"] },
    "store":    { "in": "Pack", "out": "Pack", "requires": ["validated", "redacted"], "surfaces": ["hooks", "cli", "mcp"], "actors": "*", "effects": ["fs.write"] },
    "render":   { "in": "Pack", "out": "Text", "requires": ["validated"], "surfaces": "*", "actors": "*", "effects": [] },
    "wrap":     { "in": "Text", "out": "Wrapped", "surfaces": "*", "actors": "*", "effects": [] },
    "inject":   { "in": "Wrapped", "out": "Sink", "requires": ["redacted"], "surfaces": ["hooks", "cli", "mcp", "extension"], "actors": "*", "effects": [] },
    "emit":     { "in": "Text", "out": "Sink", "requires": ["redacted"], "surfaces": ["cli"], "actors": ["human"], "effects": ["fs.write"] }
  },

  "controls": {
    "C-FAILOPEN":        { "strength": "full",    "status": "in-spec",  "mechanism": "Every hook catches all errors, bounds its own runtime, exits 0, and never emits exit 2 or decision:block.", "verify": "S6 corrupted-store run; unit test per hook event" },
    "C-NODE-SHIM":       { "strength": "full",    "status": "proposed", "mechanism": "Shell-form hook command `node <script> <event> || exit 0`; a missing runtime degrades to silence.", "verify": "Hook matrix: sh, bash, Git Bash, PowerShell 7, PowerShell 5.1, each with and without node" },
    "C-BUDGET":          { "strength": "full",    "status": "proposed", "mechanism": "Each render format has a char budget; render + wrapper stays under the sink's capacity. Counted in UTF-16 units and code points; the stricter wins.", "verify": "Property test over random packs, including astral-plane characters" },
    "C-ATOMIC":          { "strength": "full",    "status": "proposed", "mechanism": "One file per pack; write to temp and rename; index is a cache rebuilt from pack files; no cross-pack transactions.", "verify": "Kill -9 fuzz during write; 8 concurrent writers" },
    "C-STORE-LOCATION":  { "strength": "full",    "status": "proposed", "mechanism": "Store lives in a tool-owned user data directory, not in CLAUDE_PLUGIN_DATA, which uninstall deletes.", "verify": "Uninstall/reinstall scenario keeps packs" },
    "C-PERMISSION-BOUNDARY": { "threats": ["integrity"], "strength": "partial", "status": "proposed", "mechanism": "Store lives outside the project directory, so model writes to it need a permission prompt in default and acceptEdits modes. Does not hold in bypassPermissions.", "verify": "Manual check per permission mode", "theta": null },
    "C-WRAP":            { "threats": ["integrity"], "strength": "partial", "status": "in-spec",  "mechanism": "Injected pack text sits inside an untrusted-data envelope with an instruction to treat it as reference, never as commands.", "verify": "Planted-injection harness (S6), per surface", "theta": null, "thetaTarget": 0.95 },
    "C-ECHO-STRIP":      { "threats": ["integrity"], "strength": "partial", "status": "proposed", "mechanism": "Capture drops every region that arrived inside a wrapper, so injected text cannot re-enter the next pack verbatim. A model paraphrase can still carry it forward.", "verify": "Planted-marker harness over N chained sessions", "theta": null, "thetaTarget": 0.99 },
    "C-TRUST-GATE":      { "threats": ["integrity"], "strength": "full",    "status": "proposed", "mechanism": "Foreign and model-origin packs never auto-inject or reach instruction sinks. Only a human approval stamp, bound to the content hash, promotes them.", "verify": "Anti-workflows A1, A2, A3, A10" },
    "C-INSTR-GATE":      { "threats": ["integrity"], "strength": "full",    "status": "proposed", "mechanism": "Export to instruction files (AGENTS.md) requires effective trust 'user' and an explicit --i-reviewed flag in a TTY.", "verify": "Route matrix column X5" },
    "C-DRAFT-ISOLATION": { "threats": ["integrity", "confidentiality"], "strength": "full",    "status": "proposed", "mechanism": "MCP list/fetch returns only sealed session packs or approved packs, never drafts.", "verify": "MCP Inspector test with a planted draft" },
    "C-VIA-CLI-ONLY":    { "threats": ["integrity"], "strength": "full",    "status": "proposed", "mechanism": "--via exists only as a CLI argv flag. It runs through execFile with an argv array and no shell. Pack fields, MCP arguments and NMH messages cannot supply it.", "verify": "Anti-workflow A4; grep gate in CI" },
    "C-NMH-ALLOWLIST":   { "threats": ["integrity"], "strength": "full",    "status": "proposed", "mechanism": "The native host accepts a fixed read-only verb set (list, render-brief). allowed_origins is pinned to the one extension ID.", "verify": "Fuzz NMH with unknown verbs" },
    "C-NMH-SCOPE":       { "threats": ["integrity", "confidentiality"], "strength": "partial", "status": "proposed", "mechanism": "The native host serves only packs the user marked for claude.ai, and only as brief renders.", "verify": "Compromised-extension tabletop", "theta": null },
    "C-ZIP-SAFE":        { "threats": ["integrity"], "strength": "full",    "status": "proposed", "mechanism": "Official-export import reads entries in memory, never extracts to disk, and caps entry count, sizes and expansion ratio.", "verify": "Zip-slip and zip-bomb fixtures" },
    "C-FIXTURES":        { "strength": "full",    "status": "proposed", "mechanism": "Format sniffing plus versioned fixtures of the export format; an unknown shape is an actionable error, never a partial import.", "verify": "Fixture suite" },
    "C-EXT-DEGRADE":     { "strength": "full",    "status": "proposed", "mechanism": "Extension failures (selector miss, host missing, message over 1 MiB) degrade to copy-to-clipboard plus a notice; the page is never broken and the message is never sent.", "verify": "DOM-mutation fixtures" },
    "C-FAIL-LOUD":       { "strength": "full",    "status": "in-spec",  "mechanism": "The CLI and MCP server report failures with exit codes and actionable messages. They never fail silently.", "verify": "S6 corrupted store" },
    "C-SYNC":            { "strength": "full",    "status": "in-spec",  "mechanism": "CI sync check: skill copies, and wrapper markers in code, SKILL.md prose and the echo-strip parser, come from one source.", "verify": "CI job" },
    "C-FORMAT-VERSION":  { "strength": "full",    "status": "proposed", "mechanism": "formatVersion in every pack; readers accept N and N-1, preserve unknown fields, and migrate on read.", "verify": "Golden packs from every released version" },
    "C-CONTRACT":        { "strength": "full",    "status": "in-spec",  "mechanism": "CI runs every example adapter and protocol fixture (--via stdio, NMH frames).", "verify": "CI job" },
    "C-PIN":             { "strength": "full",    "status": "proposed", "mechanism": "Exact dependency pins plus lockfile; upgrades only through reviewed PRs.", "verify": "CI install --frozen-lockfile" },
    "C-SUPPLY":          { "threats": ["integrity"], "strength": "partial", "status": "proposed", "mechanism": "Hooks ship as one pre-bundled file with no runtime installs; npm provenance, 2FA, SBOM, pnpm audit.", "verify": "Release checklist", "theta": null },
    "C-CWS":             { "threats": ["integrity"], "strength": "partial", "status": "proposed", "mechanism": "Chrome Web Store 2FA, minimal permissions (claude.ai host only), staged rollout where available.", "verify": "Release checklist", "theta": null },
    "C-HEARTBEAT":       { "strength": "partial", "status": "proposed", "mechanism": "Each hook run appends to a local run log; `ctxr doctor` reports the last success per event, which makes silent hook breakage visible.", "verify": "Doctor test with hooks disabled", "theta": null },
    "C-AUDIT":           { "strength": "partial", "status": "proposed", "mechanism": "Deterministic cross-pack contradiction audit over keyed decision entries (key, value, supersedes).", "verify": "Planted-contradiction harness", "theta": null, "evidence": "OmegaClaw memory_audit bench (synthetic): theta 1.00 with fully structured beliefs, 0.27/0.09 at 50% structured; about p^2 direct, p^3 two-step." },
    "C-PROJECT-SCOPE":   { "strength": "full",    "status": "proposed", "mechanism": "Pack selection is keyed by project identity (repo root, remote-URL hash), never a global 'latest'.", "verify": "Two-project concurrent session test" },
    "C-LINEAGE":         { "strength": "full",    "status": "proposed", "mechanism": "Packs are immutable nodes with parent ids; fork creates a sibling, never an overwrite.", "verify": "Fork scenario" },
    "C-STDOUT-DISCIPLINE": { "strength": "full",  "status": "proposed", "mechanism": "Hook processes write exactly one JSON object to stdout; console.* is redirected to stderr at process start.", "verify": "Hook output snapshot test" },
    "C-HOOK-TIMEOUT":    { "strength": "full",    "status": "proposed", "mechanism": "Explicit per-hook timeout in hooks.json plus an internal deadline below it; bounded tail reads of the transcript.", "verify": "Hang injection test" },
    "C-TYPECHECK":       { "strength": "partial", "status": "in-spec",  "mechanism": "Monorepo typecheck and per-package tests on every commit. Catches interface breaks between core and surfaces, not behavioural drift.", "verify": "CI job", "theta": null },
    "C-PLUGIN-VALIDATE": { "strength": "partial", "status": "in-spec",  "mechanism": "CI runs `claude plugin validate --strict` against the current Claude Code release. Catches manifest, path and userConfig breakage, not hook behaviour.", "verify": "CI job (release checklist)", "theta": null },
    "C-GOLDEN":          { "strength": "full",    "status": "proposed", "mechanism": "Golden packs and golden renders per formatVersion; any byte change in a render, hash or parse fails CI unless the golden changes in the same PR.", "verify": "CI job" },
    "C-HASH-VERSION":    { "strength": "full",    "status": "proposed", "mechanism": "Seals record their algorithm (for example sha256 over canonical JSON, version 1); verifiers keep every released algorithm, so a canonicalization change never invalidates existing seals.", "verify": "Golden seals from every release" },
    "C-REDACT":          { "threats": ["confidentiality"], "strength": "partial", "status": "in-spec",  "mechanism": "Pattern redaction at capture and again at every egress (idempotent), with counts reported.", "verify": "Planted-secret harness", "theta": null, "thetaTarget": 1.0 }
  },

  "components": [
    { "id": "node",        "layer": "external", "name": "Node.js runtime on the user's machine (not guaranteed; PN-06)" },
    { "id": "cc-hooks",    "layer": "external", "name": "Claude Code hooks contract" },
    { "id": "cc-plugins",  "layer": "external", "name": "Claude Code plugin loader, CLAUDE_PLUGIN_DATA, userConfig" },
    { "id": "marketplace", "layer": "external", "name": "Plugin marketplace repository" },
    { "id": "cai-skills",  "layer": "external", "name": "claude.ai skill runtime (frontmatter allowlist)" },
    { "id": "cai-dom",     "layer": "external", "name": "claude.ai web UI DOM (composer); undocumented" },
    { "id": "chrome-nm",   "layer": "external", "name": "Chrome native messaging API" },
    { "id": "mcp-sdk",     "layer": "external", "name": "MCP TypeScript SDK and zod" },
    { "id": "export-fmt", "secretOrigin": true,  "layer": "external", "name": "claude.ai official data export format; undocumented" },
    { "id": "npm",         "layer": "external", "name": "npm registry and dependency tree" },
    { "id": "cws",         "layer": "external", "name": "Chrome Web Store distribution" },
    { "id": "git-remote", "egress": true,  "layer": "external", "name": "Shared git remote (teammates, CI, cloud sessions)" },

    { "id": "spec",          "layer": "contract", "name": "SPEC.md and JSON Schema (pack format)" },
    { "id": "wrapper-proto", "layer": "contract", "name": "Untrusted-content wrapper protocol (markers and prose)" },

    { "id": "schema",   "layer": "core", "name": "parse, validate, migrate" },
    { "id": "canon",    "layer": "core", "name": "canonical JSON and content hash" },
    { "id": "redact",   "layer": "core", "name": "secret patterns and counts" },
    { "id": "render",   "layer": "core", "name": "brief, full, md, agents-md, json renders" },
    { "id": "wrap",     "layer": "core", "name": "wrapper implementation" },
    { "id": "store",    "layer": "core", "name": "filesystem store" },
    { "id": "capture",  "layer": "core", "name": "transcript to draft pack (deterministic)" },
    { "id": "importer", "layer": "core", "name": "file, stdin, official-export and adapter import" },
    { "id": "audit",    "layer": "core", "name": "cross-pack contradiction audit" },

    { "id": "shim",      "layer": "surface", "name": "hook command wrapper (runtime detection)" },
    { "id": "hooks",     "layer": "surface", "name": "SessionStart, PreCompact and SessionEnd handlers", "failPolicy": "open" },
    { "id": "plugin",    "layer": "surface", "name": "plugin manifest and marketplace entry" },
    { "id": "skill",     "layer": "surface", "name": "SKILL.md shipped in the plugin" },
    { "id": "skill-zip", "layer": "surface", "name": "context-relay-skill.zip for claude.ai upload" },
    { "id": "cli",       "layer": "surface", "name": "ctxr" },
    { "id": "mcp",       "layer": "surface", "name": "MCP server" },
    { "id": "nmh",       "layer": "surface", "name": "native messaging host" },
    { "id": "extension", "layer": "surface", "name": "Chrome extension" },
    { "id": "mcpb",      "layer": "surface", "name": ".mcpb bundle (Phase 7, optional)" },
    { "id": "adapters",  "layer": "surface", "name": "example --via adapters" },

    { "id": "store-data",   "layer": "data", "name": "sealed session packs and approved packs" },
    { "id": "store-drafts", "layer": "data", "name": "foreign and model-origin drafts" },
    { "id": "repo-packs",   "layer": "data", "name": "packs committed to a repository" },
    { "id": "agents-md",    "layer": "data", "name": "exported AGENTS.md instruction file" },

    { "id": "cc-session", "secretOrigin": true, "agent": true,   "layer": "sink", "name": "a Claude Code session's context and agency" },
    { "id": "cai-chat", "egress": true, "secretOrigin": true, "agent": true,     "layer": "sink", "name": "a claude.ai conversation" },
    { "id": "other-agents", "egress": true, "agent": true, "layer": "sink", "name": "other coding agents and MCP clients" },
    { "id": "user-host",    "layer": "sink", "name": "the user's machine and account (code execution)" }
  ],

