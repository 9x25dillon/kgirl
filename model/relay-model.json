  "acceptedCycles": [
    {
      "nodes": ["store-data", "hooks", "cc-session", "capture"],
      "decision": "D-008",
      "rationale": "Automatic continuity (S1) is the product. Its re-injection loop can be damped (C-WRAP, C-ECHO-STRIP) but not cut without removing the feature. Accepted if planted-injection persistence after 3 chained sessions is at most 1 - thetaTarget."
    },
    {
      "nodes": ["store-data", "mcp", "cc-session", "capture"],
      "decision": "D-008",
      "rationale": "Same loop as above, reached through a model-initiated MCP fetch instead of the SessionStart hook."
    }
  ],

